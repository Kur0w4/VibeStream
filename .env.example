# ── Variables del Servidor (Backend) ──────────────────────────

# Puerto donde correrá el servidor (Opcional, usualmente lo asigna Render automáticamente)
PORT=3000

# Secreto para firmar los JSON Web Tokens (Reemplazar con una cadena muy segura y larga)
JWT_SECRET="reemplazar_con_una_cadena_secreta_muy_segura_para_jwt_123!"

# ── Credenciales de Turso (Base de Datos) ─────────────────────
# URL de conexión de la base de datos Turso (ej. libsql://vibe-db-usuario.turso.io)
TURSO_DATABASE_URL="reemplazar_con_tu_url_de_turso"

# Token de autenticación de Turso
TURSO_AUTH_TOKEN="reemplazar_con_tu_auth_token_de_turso"


# ── Credenciales de Firebase (Frontend) ───────────────────────
# Estas variables deben iniciar con VITE_ para que Vite las pase al Frontend
# y la autenticación de Firebase (src/lib/firebase.ts) funcione correctamente.

VITE_FIREBASE_API_KEY="reemplazar_con_tu_api_key_de_firebase"
VITE_FIREBASE_AUTH_DOMAIN="reemplazar_con_tu_auth_domain_de_firebase"
VITE_FIREBASE_PROJECT_ID="reemplazar_con_tu_project_id_de_firebase"
VITE_FIREBASE_STORAGE_BUCKET="reemplazar_con_tu_storage_bucket_de_firebase"
VITE_FIREBASE_MESSAGING_SENDER_ID="reemplazar_con_tu_messaging_sender_id_de_firebase"
VITE_FIREBASE_APP_ID="reemplazar_con_tu_app_id_de_firebase"

# ── Configuración Adicional (Opcional) ─────────────────────────
# NODE_ENV="production"
